# Render Deployment Environment Variables
# Generate a 64-char hex key via: openssl rand -hex 32
SECRET_KEY=dev-insecure-secret-key-niyantran-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Render Managed PostgreSQL or external DB URL (defaults to sqlite:///./block_planning.db if omitted)
# Render's free tier has an ephemeral disk, so local SQLite will reset on restart.
DATABASE_URL=sqlite:///./block_planning.db

# Port assigned dynamically by Render (defaults to 10000)
PORT=10000

# Live SMTP Configuration (Gmail 587 STARTTLS)
# Leave blank to fallback gracefully to terminal printing
SMTP_USERNAME=
SMTP_PASSWORD=
